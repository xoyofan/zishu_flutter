+  /// 栏目浏览;不支持为 `null`。
+  BrowseRepository? get browse;
+
+  /// 搜索;不支持为 `null`。
+  SearchRepository? get search;
+
+  /// 弹幕连接;不支持为 `null`(不返回空连接占位)。
+  DanmakuConnector? get danmaku;
+
+  /// 轻量状态刷新(只取元信息、不取流不写缓存);未实现为 `null`。
+  RoomSummaryRefresher? get refresher;
